<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Something I Made For You ❤️</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #070507;
    color: white;
    overflow-x: hidden;
}

/* BACKGROUND */

body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -2;

    background:
        radial-gradient(circle at 15% 20%, rgba(255, 55, 115, .20), transparent 30%),
        radial-gradient(circle at 85% 80%, rgba(170, 30, 90, .18), transparent 35%),
        linear-gradient(145deg, #070507, #18070f, #050505);
}

/* INTRO */

#intro {
    position: fixed;
    inset: 0;
    z-index: 9999;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 30px;
    text-align: center;

    background:
        radial-gradient(circle at center, #210b15, #070507 70%);

    transition:
        opacity 1.2s ease,
        visibility 1.2s ease;
}

#intro.hide {
    opacity: 0;
    visibility: hidden;
}

.intro-content {
    max-width: 520px;
    animation: fadeUp 1.5s ease;
}

.intro-heart {
    font-size: 70px;
    margin-bottom: 25px;

    animation: heartbeat 1.5s infinite;
}

.intro-content h1 {
    font-size: clamp(42px, 11vw, 75px);
    line-height: 1;
    margin-bottom: 25px;
}

.intro-content h1 span {
    color: #ff5a91;
}

.intro-content p {
    color: #cbb9c0;
    font-size: 17px;
    line-height: 1.8;
    margin-bottom: 35px;
}

.open-button {
    border: none;

    padding: 17px 36px;

    border-radius: 50px;

    background: linear-gradient(
        135deg,
        #ff4f88,
        #b91d59
    );

    color: white;

    font-size: 16px;
    font-weight: 700;

    cursor: pointer;

    box-shadow:
        0 15px 50px rgba(255, 55, 120, .25);

    transition: .3s;
}

.open-button:hover {
    transform: scale(1.06);
}

/* MAIN */

main {
    opacity: 0;
    transition: opacity 1.5s ease;
}

main.show {
    opacity: 1;
}

/* HERO */

.hero {
    min-height: 100vh;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;

    padding: 30px;

    position: relative;
}

.hero-content {
    max-width: 700px;
}

.hero-small {
    color: #ff719d;

    text-transform: uppercase;

    letter-spacing: 5px;

    font-size: 11px;

    margin-bottom: 25px;
}

.hero h2 {
    font-size: clamp(50px, 13vw, 100px);

    line-height: .95;

    margin-bottom: 30px;
}

.hero h2 span {
    color: #ff568d;
}

.hero p {
    color: #cbbbc1;

    font-size: 17px;

    line-height: 1.8;
}

.scroll {
    position: absolute;

    bottom: 30px;

    color: #806d74;

    font-size: 11px;

    letter-spacing: 3px;
}

/* SECTIONS */

section {
    min-height: 85vh;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 80px 22px;
}

.card {
    width: 100%;
    max-width: 720px;

    padding: 45px 30px;

    border-radius: 30px;

    background: rgba(255,255,255,.045);

    border: 1px solid rgba(255,255,255,.08);

    backdrop-filter: blur(20px);

    box-shadow:
        0 30px 100px rgba(0,0,0,.35);
}

/* LETTER */

.letter h2 {
    font-size: clamp(34px, 8vw, 55px);

    margin-bottom: 30px;
}

.letter p {
    color: #d4c5ca;

    font-size: 17px;

    line-height: 1.9;

    margin-bottom: 20px;
}

.signature {
    margin-top: 35px;

    text-align: right;

    color: #ff709d;

    font-size: 18px;
}

/* MUSIC */

.music-section {
    text-align: center;
}

.album {
    width: 190px;
    height: 190px;

    margin: 0 auto 30px;

    border-radius: 28px;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 70px;

    background:
        radial-gradient(circle at 30% 25%, #ff709d, transparent 25%),
        linear-gradient(135deg, #8f123f, #16040c);

    box-shadow:
        0 25px 70px rgba(255,50,110,.25);

    animation: albumPulse 3s infinite;
}

.music-section h2 {
    font-size: 32px;

    margin-bottom: 10px;
}

.song-title {
    color: #ff6d9b;

    font-size: 17px;

    margin-bottom: 25px;
}

.music-section p {
    color: #c9b8bf;

    line-height: 1.8;

    font-size: 16px;
}

/* FINAL */

.final {
    min-height: 100vh;

    text-align: center;
}

.final-heart {
    font-size: 65px;

    margin-bottom: 25px;

    animation: heartbeat 1.5s infinite;
}

.final h2 {
    font-size: clamp(40px, 10vw, 75px);

    line-height: 1;

    margin-bottom: 30px;
}

.final p {
    color: #cdbcc2;

    font-size: 17px;

    line-height: 1.9;

    margin-bottom: 15px;
}

.love {
    color: #ff5b91;

    font-size: clamp(35px, 9vw, 65px);

    font-weight: 700;

    margin-top: 35px;
}

/* MUSIC BUTTON */

.music-button {
    position: fixed;

    right: 18px;
    bottom: 18px;

    width: 56px;
    height: 56px;

    border-radius: 50%;

    border: 1px solid rgba(255,255,255,.15);

    background: rgba(20,5,12,.9);

    color: white;

    font-size: 20px;

    cursor: pointer;

    display: none;

    z-index: 1000;

    backdrop-filter: blur(15px);
}

.music-button.show {
    display: block;
}

/* FLOATING HEARTS */

.floating-heart {
    position: fixed;

    bottom: -40px;

    pointer-events: none;

    z-index: 10000;

    animation: floatUp linear forwards;
}

/* ANIMATIONS */

@keyframes fadeUp {

    from {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes heartbeat {

    0%,100% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.18);
    }
}

@keyframes albumPulse {

    0%,100% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.05);
    }
}

@keyframes floatUp {

    from {
        transform:
            translateY(0)
            rotate(0deg);

        opacity: 1;
    }

    to {
        transform:
            translateY(-110vh)
            rotate(360deg);

        opacity: 0;
    }
}

@media(max-width:600px) {

    .card {
        padding: 35px 22px;
    }

    .letter p {
        font-size: 16px;
    }
}
</style>
</head>

<body>


<!-- INTRO -->

<div id="intro">

    <div class="intro-content">

        <div class="intro-heart">
            ❤️
        </div>

        <h1>
            I made this<br>
            <span>for you.</span>
        </h1>

        <p>
            I could have just sent you a message,
            but I wanted to do something a little
            more meaningful.
        </p>

        <button
            class="open-button"
            onclick="openWebsite()">

            Open this ❤️

        </button>

    </div>

</div>


<!-- HIDDEN YOUTUBE PLAYER -->

<div id="youtube-player"></div>


<!-- WEBSITE -->

<main id="main">


    <!-- HERO -->

    <div class="hero">

        <div class="hero-content">

            <div class="hero-small">
                Something from my heart
            </div>

            <h2>
                For <span>Bokang.</span>
            </h2>

            <p>
                Take your time reading this.
                There's no rush.
            </p>

        </div>

        <div class="scroll">
            ↓ SCROLL ↓
        </div>

    </div>


    <!-- APOLOGY -->

    <section>

        <div class="card letter">

            <h2>
                Bokang ❤️
            </h2>

            <p>
                I wanted to make this because I know that
                sometimes a simple "I'm sorry" doesn't
                really explain how you feel about everything.
            </p>

            <p>
                I know I've made mistakes.
                I know there are things I could have handled
                differently, and I know some of my actions
                may have hurt you.
            </p>

            <p>
                I'm genuinely sorry for those moments.
            </p>

            <p>
                I'm not making this because I expect everything
                to suddenly be perfect.
                I'm making it because I wanted to actually
                put effort into saying what is in my heart.
            </p>

            <p>
                You deserve to feel appreciated,
                respected, cared for and loved.
            </p>

            <p>
                And I'm sorry for every moment where
                I failed to make you feel that way.
            </p>

            <p>
                I hope you can see that this isn't just
                me saying words.
                I really mean my apology.
            </p>

            <div class="signature">
                — Molope ❤️
            </div>

        </div>

    </section>


    <!-- MUSIC -->

    <section class="music-section">

        <div class="card">

            <div class="album">
                🎵
            </div>

            <h2>
                I chose this song for you.
            </h2>

            <div class="song-title">
                Sienna Spiro — The Visitor
            </div>

            <p>
                I wanted you to listen to this while
                you read the rest of this.
            </p>

            <p style="margin-top:15px;">
                Just let the music play and take your time.
            </p>

        </div>

    </section>


    <!-- MORE -->

    <section>

        <div class="card letter">

            <h2>
                I mean this.
            </h2>

            <p>
                I don't want this website to be the thing
                that proves I'm sorry.
            </p>

            <p>
                I want the way I act afterwards to prove it.
            </p>

            <p>
                I want to communicate better.
                I want to understand you better.
                And I want to become better at showing you
                how much you mean to me.
            </p>

            <p>
                I know that nobody is perfect.
                But that doesn't mean we shouldn't try
                to become better for the people we love.
            </p>

            <p>
                So this is me saying:
                I'm sorry, Bokang.
            </p>

        </div>

    </section>


    <!-- FINAL -->

    <section class="final">

        <div class="card">

            <div class="final-heart">
                ❤️
            </div>

            <h2>
                Before you leave...
            </h2>

            <p>
                Thank you for every memory,
                every laugh, every conversation,
                and every moment we've shared.
            </p>

            <p>
                I hope you know that you mean
                more to me than I sometimes know
                how to put into words.
            </p>

            <div class="love">
                I love you, Bokang. ❤️
            </div>

            <p style="margin-top:30px;">
                — Molope
            </p>

        </div>

    </section>


</main>


<!-- MUSIC CONTROL -->

<button
    id="musicButton"
    class="music-button"
    onclick="toggleMusic()">

    🎵

</button>


<script>

/*
==================================================
YOUTUBE MUSIC
Sienna Spiro — The Visitor

YouTube Video ID:
5Wq1iDyEjF8
==================================================
*/

let player = null;
let musicPlaying = false;


/* LOAD YOUTUBE */

function loadYouTube() {

    const script =
        document.createElement("script");

    script.src =
        "https://www.youtube.com/iframe_api";

    document.head.appendChild(script);
}

loadYouTube();


/* YOUTUBE READY */

function onYouTubeIframeAPIReady() {

    player = new YT.Player(
        "youtube-player",
        {

            height: "0",
            width: "0",

            videoId: "5Wq1iDyEjF8",

            playerVars: {

                autoplay: 0,

                controls: 0,

                playsinline: 1,

                loop: 1,

                playlist: "5Wq1iDyEjF8"

            },

            events: {

                onReady: function(event) {

                    event.target.setVolume(70);

                }

            }

        }
    );

}


/* OPEN WEBSITE + START MUSIC */

function openWebsite() {

    document
        .getElementById("intro")
        .classList
        .add("hide");


    document
        .getElementById("main")
        .classList
        .add("show");


    document
        .getElementById("musicButton")
        .classList
        .add("show");


    /*
       The button click is a real user interaction.
       This gives the browser permission to start audio.
    */

    if (player) {

        player.playVideo();

        musicPlaying = true;

    }


    createHearts(25);

}


/* MUSIC CONTROL */

function toggleMusic() {

    if (!player) return;


    if (musicPlaying) {

        player.pauseVideo();

        musicPlaying = false;

        document
            .getElementById("musicButton")
            .innerHTML = "🔇";

    } else {

        player.playVideo();

        musicPlaying = true;

        document
            .getElementById("musicButton")
            .innerHTML = "🎵";

    }

}


/* HEART EFFECT */

function createHearts(amount) {

    for (
        let i = 0;
        i < amount;
        i++
    ) {

        setTimeout(function() {

            const heart =
                document.createElement("div");

            heart.className =
                "floating-heart";

            const hearts = [
                "❤️",
                "💕",
                "💗",
                "💖",
                "💓"
            ];

            heart.innerHTML =
                hearts[
                    Math.floor(
                        Math.random() *
                        hearts.length
                    )
                ];


            heart.style.left =
                Math.random() * 100 + "vw";


            heart.style.fontSize =
                (15 +
                Math.random() * 25) + "px";


            heart.style.animationDuration =
                (4 +
                Math.random() * 4) + "s";


            document.body.appendChild(heart);


            setTimeout(function() {

                heart.remove();

            }, 8000);

        }, i * 100);

    }

}


/* EXTRA HEARTS AS SHE SCROLLS */

window.addEventListener(
    "scroll",
    function() {

        if (
            Math.random() < 0.025
        ) {

            createHearts(1);

        }

    }
);

</script>

</body>
</html>
