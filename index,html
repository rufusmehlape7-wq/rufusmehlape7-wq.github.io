<!-- =================================
     MUSIC BUTTON
================================= -->

<button
    id="musicButton"
    class="music-button"
    onclick="toggleMusic()">

    🎵

</button>



<script>


/* =================================
   VARIABLES
================================= */

let youtubePlayer = null;

let musicPlaying = false;


/* =================================
   OPEN WEBSITE
================================= */

function openWebsite() {


    /*
       Open the website immediately.
    */

    document
        .getElementById("intro")
        .classList
        .add("hide");


    document
        .getElementById("main")
        .classList
        .add("show");


    document
        .getElementById("musicButton")
        .classList
        .add("show");


    /*
       IMPORTANT:

       This function is called directly
       from the user's button tap.

       That gives YouTube the best chance
       of starting playback.
    */

    startMusic();


    /*
       Romantic hearts.
    */

    createHearts(30);

}


/* =================================
   START MUSIC
================================= */

function startMusic() {


    if (youtubePlayer) {

        return;

    }


    /*
       Create the YouTube iframe.
    */

    youtubePlayer =
        document.createElement("iframe");


    /*
       Exact YouTube video:

       Sienna Spiro
       The Visitor

       ID:
       5Wq1iDyEjF8
    */

    youtubePlayer.src =

        "https://www.youtube.com/embed/" +

        "5Wq1iDyEjF8" +

        "?autoplay=1" +

        "&playsinline=1" +

        "&rel=0" +

        "&controls=0" +

        "&modestbranding=1";


    youtubePlayer.width = "1";

    youtubePlayer.height = "1";


    youtubePlayer.allow =
        "autoplay; encrypted-media";


    youtubePlayer.setAttribute(
        "frameborder",
        "0"
    );


    youtubePlayer.setAttribute(
        "allowfullscreen",
        ""
    );


    /*
       Add player to page.
    */

    document
        .getElementById(
            "youtube-player"
        )
        .appendChild(
            youtubePlayer
        );


    musicPlaying = true;

}


/* =================================
   MUSIC CONTROL
================================= */

function toggleMusic() {


    if (!youtubePlayer) {

        startMusic();

        return;

    }


    /*
       Send YouTube command.
    */

    if (musicPlaying) {

        youtubePlayer
            .contentWindow
            .postMessage(

                JSON.stringify({

                    event: "command",

                    func: "pauseVideo",

                    args: []

                }),

                "*"

            );


        musicPlaying = false;


        document
            .getElementById(
                "musicButton"
            )
            .innerHTML = "🔇";

    }

    else {

        youtubePlayer
            .contentWindow
            .postMessage(

                JSON.stringify({

                    event: "command",

                    func: "playVideo",

                    args: []

                }),

                "*"

            );


        musicPlaying = true;


        document
            .getElementById(
                "musicButton"
            )
            .innerHTML = "🎵";

    }

}


/* =================================
   FLOATING HEARTS
================================= */

function createHearts(amount) {


    for (
        let i = 0;
        i < amount;
        i++
    ) {


        setTimeout(

            function() {


                const heart =
                    document.createElement(
                        "div"
                    );


                heart.className =
                    "floating-heart";


                const types = [

                    "❤️",
                    "💕",
                    "💗",
                    "💖",
                    "💓"

                ];


                heart.innerHTML =
                    types[
                        Math.floor(
                            Math.random()
                            *
                            types.length
                        )
                    ];


                heart.style.left =
                    Math.random()
                    * 100
                    + "vw";


                heart.style.fontSize =
                    15
                    +
                    Math.random()
                    * 25
                    + "px";


                heart.style.animationDuration =
                    4
                    +
                    Math.random()
                    * 4
                    + "s";


                document
                    .body
                    .appendChild(
                        heart
                    );


                setTimeout(

                    function() {

                        heart.remove();

                    },

                    8000

                );


            },

            i * 100

        );

    }

}


</script>


