<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<meta name="theme-color"
content="#080509">

<title>For Bokang ❤️</title>

<style>

/* =========================
   BASIC SETUP
========================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    background: #080509;

    color: white;

    overflow-x: hidden;
}


/* =========================
   BACKGROUND
========================= */

body::before {

    content: "";

    position: fixed;

    inset: 0;

    z-index: -2;

    background:

        radial-gradient(
            circle at 20% 20%,
            rgba(255,60,120,.20),
            transparent 32%
        ),

        radial-gradient(
            circle at 80% 75%,
            rgba(190,35,100,.18),
            transparent 35%
        ),

        linear-gradient(
            135deg,
            #080509,
            #1b0712,
            #050407
        );
}


/* =========================
   OPENING SCREEN
========================= */

#intro {

    position: fixed;

    inset: 0;

    z-index: 9999;

    display: flex;

    align-items: center;

    justify-content: center;

    text-align: center;

    padding: 25px;

    background:

        radial-gradient(
            circle at center,
            #280b19,
            #080509 70%
        );

    transition:
        opacity 1s ease,
        visibility 1s ease;
}

#intro.hide {

    opacity: 0;

    visibility: hidden;
}

.intro-content {

    width: 100%;

    max-width: 520px;

    animation:
        fadeUp 1.3s ease;
}

.intro-heart {

    font-size: 72px;

    margin-bottom: 25px;

    animation:
        heartbeat 1.5s infinite;
}

.intro-content h1 {

    font-size:
        clamp(45px,12vw,80px);

    line-height: .92;

    margin-bottom: 28px;
}

.intro-content h1 span {

    color: #ff5a91;
}

.intro-content p {

    color: #d0bec6;

    font-size: 17px;

    line-height: 1.8;

    margin-bottom: 35px;
}

.open-button {

    border: none;

    padding:
        17px 38px;

    border-radius: 50px;

    background:

        linear-gradient(
            135deg,
            #ff4f88,
            #b91d59
        );

    color: white;

    font-size: 16px;

    font-weight: 700;

    cursor: pointer;

    box-shadow:

        0 15px 50px
        rgba(255,55,120,.30);

    -webkit-tap-highlight-color:
        transparent;

    transition:
        transform .2s ease;
}

.open-button:active {

    transform:
        scale(.94);
}


/* =========================
   MAIN WEBSITE
========================= */

main {

    opacity: 0;

    transition:
        opacity 1.3s ease;
}

main.show {

    opacity: 1;
}


/* =========================
   HERO
========================= */

.hero {

    min-height: 100vh;

    display: flex;

    align-items: center;

    justify-content: center;

    text-align: center;

    padding: 30px;

    position: relative;
}

.hero-content {

    max-width: 720px;

    animation:
        fadeUp 1.5s ease;
}

.eyebrow {

    color: #ff719d;

    text-transform: uppercase;

    letter-spacing: 5px;

    font-size: 11px;

    margin-bottom: 25px;
}

.hero h2 {

    font-size:
        clamp(60px,15vw,110px);

    line-height: .88;

    margin-bottom: 30px;
}

.hero h2 span {

    color: #ff568d;
}

.hero p {

    color: #cdbbc2;

    font-size: 17px;

    line-height: 1.8;
}

.scroll {

    position: absolute;

    bottom: 30px;

    color: #806d74;

    font-size: 11px;

    letter-spacing: 3px;

    animation:
        bounce 2s infinite;
}


/* =========================
   SECTIONS
========================= */

section {

    min-height: 85vh;

    display: flex;

    align-items: center;

    justify-content: center;

    padding:
        80px 22px;
}

.card {

    width: 100%;

    max-width: 720px;

    padding:
        45px 30px;

    border-radius: 30px;

    background:
        rgba(255,255,255,.045);

    border:
        1px solid
        rgba(255,255,255,.09);

    backdrop-filter:
        blur(20px);

    box-shadow:
        0 30px 100px
        rgba(0,0,0,.40);
}


/* =========================
   MESSAGE
========================= */

.message h2 {

    font-size:
        clamp(35px,8vw,55px);

    margin-bottom: 30px;
}

.message p {

    color: #d5c5cb;

    font-size: 17px;

    line-height: 1.9;

    margin-bottom: 21px;
}


/* =========================
   MUSIC SECTION
========================= */

.song-section {

    text-align: center;
}

.song-icon {

    width: 175px;

    height: 175px;

    margin:
        0 auto 30px;

    border-radius: 30px;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 72px;

    background:

        radial-gradient(
            circle at 30% 25%,
            #ff709d,
            transparent 25%
        ),

        linear-gradient(
            135deg,
            #8f123f,
            #16040c
        );

    box-shadow:

        0 25px 70px
        rgba(255,50,110,.25);

    animation:
        musicPulse 3s infinite;
}

.song-section h2 {

    font-size: 34px;

    margin-bottom: 18px;
}

.song-section p {

    color: #d0bec6;

    font-size: 17px;

    line-height: 1.9;

    margin-bottom: 18px;
}

.song-name {

    color: #ff709d;

    font-size: 18px;

    font-weight: 600;

    margin-bottom: 25px;
}


/* =========================
   MUSIC BUTTON
========================= */

.music-button {

    position: fixed;

    right: 18px;

    bottom: 18px;

    z-index: 1000;

    width: 56px;

    height: 56px;

    border-radius: 50%;

    border:
        1px solid
        rgba(255,255,255,.15);

    background:
        rgba(20,5,12,.90);

    color: white;

    font-size: 21px;

    cursor: pointer;

    display: none;

    backdrop-filter:
        blur(15px);
}

.music-button.show {

    display: block;
}


/* =========================
   HIDDEN YOUTUBE PLAYER
========================= */

#youtube-player {

    position: fixed;

    width: 1px;

    height: 1px;

    left: -100px;

    top: -100px;

    opacity: 0;

    pointer-events: none;
}


/* =========================
   FINAL
========================= */

.final {

    min-height: 100vh;

    text-align: center;
}

.final-heart {

    font-size: 68px;

    margin-bottom: 25px;

    animation:
        heartbeat 1.5s infinite;
}

.final h2 {

    font-size:
        clamp(40px,10vw,75px);

    line-height: 1;

    margin-bottom: 30px;
}

.final p {

    color: #cdbcc2;

    font-size: 17px;

    line-height: 1.9;

    margin-bottom: 15px;
}

.final-love {

    color: #ff5b91;

    font-size:
        clamp(35px,9vw,65px);

    font-weight: 700;

    line-height: 1.05;

    margin-top: 35px;
}


/* =========================
   FLOATING HEARTS
========================= */

.floating-heart {

    position: fixed;

    bottom: -40px;

    pointer-events: none;

    z-index: 10000;

    animation:
        floatUp linear forwards;
}


/* =========================
   ANIMATIONS
========================= */

@keyframes fadeUp {

    from {

        opacity: 0;

        transform:
            translateY(25px);
    }

    to {

        opacity: 1;

        transform:
            translateY(0);
    }
}

@keyframes heartbeat {

    0%,100% {

        transform:
            scale(1);
    }

    50% {

        transform:
            scale(1.18);
    }
}

@keyframes musicPulse {

    0%,100% {

        transform:
            scale(1);
    }

    50% {

        transform:
            scale(1.05);
    }
}

@keyframes bounce {

    0%,100% {

        transform:
            translateY(0);
    }

    50% {

        transform:
            translateY(8px);
    }
}

@keyframes floatUp {

    from {

        transform:
            translateY(0)
            rotate(0deg);

        opacity: 1;
    }

    to {

        transform:
            translateY(-110vh)
            rotate(360deg);

        opacity: 0;
    }
}


/* =========================
   MOBILE
========================= */

@media (max-width:600px) {

    .card {

        padding:
            35px 22px;
    }

    .message p {

        font-size: 16px;
    }

}

</style>

</head>


<body>


<!-- =================================
     OPENING SCREEN
================================= -->

<div id="intro">

